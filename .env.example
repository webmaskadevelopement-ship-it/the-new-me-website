# ============================================================
# Environment variables — API-token based credentials ONLY.
# This is a TEMPLATE. Never commit real values; never put
# tokens in git remote URLs or in any tracked file.
# ============================================================

# GitHub API token (fine-grained, scope: repo contents read/write)
# Used by deploy.sh when pushing via HTTPS (alternative: `gh auth login`).
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Netlify (CI/CD via .github/workflows/deploy-netlify.yml) ---
# Create in Netlify dashboard → User settings → Applications → Personal access tokens
NETLIFY_AUTH_TOKEN=

# Netlify site API ID (Site settings → Site details → Site ID)
NETLIFY_SITE_ID=

# --- Local dev ---
# PORT is read by scripts/dev-server.mjs (default 8000)
PORT=8000
