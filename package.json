{
  "name": "the-new-me-website",
  "version": "2.0.0",
  "description": "The New Me - Reverse Aging & Botanical Formulation Platform",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "dev": "node scripts/dev-server.mjs",
    "serve": "node scripts/dev-server.mjs",
    "build": "echo 'Static production ready. (Tailwind CSS is precompiled in vendor/tailwind.prod.css)'",
    "deploy": "./deploy.sh",
    "push": "./deploy.sh",
    "build:css": "tailwindcss -c scripts/tailwind.config.js -i scripts/tailwind.input.css -o vendor/tailwind.prod.css --minify",
    "scan:secrets": "bash scripts/scan-secrets.sh"
  },
  "keywords": [
    "wellness",
    "botanical-protein",
    "longevity",
    "clinical-botany",
    "reverse-aging"
  ],
  "author": "The New Me",
  "license": "UNLICENSED"
}
